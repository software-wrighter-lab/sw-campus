(
    places: [
        (id: "campus", kind: Campus, title: "Software Wrighter Research Campus", tagline: "A growing campus of projects, experiments, and ideas.", summary: "A place to explore Software Wrighter's machines, languages, sciences, and working demonstrations.", status: Open, children: ["computer-history", "computer-science", "hardware-lab", "computational-sciences", "digital-media", "interactive-computing", "commons", "future-nw", "future-ne", "future-sw"], scene: Some("campus"), links: [], aliases: ["campus", "research campus", "Software Wrighter"], example_queries: ["where is the campus", "show me the research campus"]),
        (id: "computer-history", kind: Building, title: "Computer History Museum", tagline: "Vintage systems, emulations, and interactive demos.", summary: "Historic computers rebuilt as emulators you can run in the browser, with the toolchains written to program them.", status: Open, children: ["ibm-1130", "ibm-360", "ibm-370", "ibm-390", "early-computers", "personal-computing", "processors", "interfaces-media", "minicomputers", "game-machines", "special-exhibits", "library-archives", "vacuum-tubes", "transistors", "punch-cards", "core-memory", "paper-tape", "early-pcs"], scene: Some("computer-history"), links: [], aliases: ["computer history", "history museum", "museum", "old computers"], example_queries: ["where is the computer history museum", "take me to the old computers"]),
        (id: "ibm-1130", kind: Wing, title: "IBM 1130 Wing", tagline: "The 1131 console, its peripherals, and the toolchain written to program it.", summary: "A walk through the IBM 1130 system and the machines attached to it.", status: Open, children: ["029", "1130", "1442", "1132", "2310"], scene: Some("ibm-1130"), links: [], aliases: ["1130", "IBM 1130", "1130 wing", "card machines"], example_queries: ["where is the 1130", "take me to the machine with the toggle switches"]),
        (id: "029", kind: Exhibit, title: "IBM 029 Card Punch", tagline: "Punches 80-column cards from the keyboard, with Hollerith encoding.", summary: "The IBM 029 keypunch converted typed characters into punched cards. It belongs beside the 1130 because card decks were a practical way to prepare programs and data; the same punched representation makes a useful counterpoint to APL's compact, symbolic notation. This exhibit will eventually connect the keypunch interface to a runnable card deck.", status: Open, children: [], scene: None, links: [], aliases: ["029", "card punch", "keypunch", "card machine"], example_queries: ["where is the card punch", "show me the keypunch"]),
        (id: "1130", kind: Exhibit, title: "IBM 1130 Console (1131 CPU)", tagline: "A 16-bit scientific computer with lights, switches, and a console printer.", summary: "The IBM 1130 was a compact scientific and engineering computer built around the 1131 processor. Its console made registers and machine state visible through lamps and switches, while cards, disk cartridges, and printers made a complete working system. The browser simulator recreates that system and its peripherals.", status: Open, children: [], scene: None, links: [
            (label: "Run IBM 1130 system simulator", url: "https://softwarewrighter.github.io/demo-ibm-1130-system/", kind: Run),
            (label: "Source: IBM 1130 system simulator", url: "https://github.com/softwarewrighter/demo-ibm-1130-system", kind: Source),
        ], aliases: ["1130 console", "1131", "toggle switches", "console"], example_queries: ["where is the console with toggle switches", "show me the IBM 1130 console"]),
        (id: "1442", kind: Exhibit, title: "IBM 1442 Card Read Punch", tagline: "Reads and punches 80-column cards at up to 600 cards a minute.", summary: "The IBM 1442 read punched cards into the 1130 and could punch cards back out, at a speed that made card decks practical for recurring work. It is the physical bridge between the keypunch, the 1130 program, and the machine's results; the simulator exposes that card flow and the related radio experiment.", status: Open, children: ["radio"], scene: None, links: [
            (label: "Run IBM 1442 system simulator", url: "https://softwarewrighter.github.io/demo-ibm-1130-system/", kind: Run),
            (label: "Source: IBM 1442 system simulator", url: "https://github.com/softwarewrighter/demo-ibm-1130-system", kind: Source),
        ], aliases: ["1442", "card reader", "card read punch"], example_queries: ["where is the card reader", "show me the IBM 1442"]),
        (id: "radio", kind: Demo, title: "Card-reader radio: music by RFI", tagline: "Music made from the rhythm of punched cards.", summary: "A planned experiment using radio-frequency interference from the 1442 card reader to turn machine activity into sound. It remains a placeholder until the demo repository and its reproducible browser experience are available.", status: Placeholder, children: [], scene: None, links: []),
        (id: "1132", kind: Exhibit, title: "IBM 1132 Printer", tagline: "A 132-column line printer running up to 600 lines a minute.", summary: "A future exhibit for the IBM 1132 printer.", status: Placeholder, children: [], scene: None, links: []),
        (id: "2310", kind: Exhibit, title: "IBM 2310 Disk Drive", tagline: "The 2315 cartridge: one platter, half a million words, and the sound of a seek.", summary: "A future exhibit for the removable disk attached to the IBM 1130.", status: Placeholder, children: [], scene: None, links: []),
        (id: "ibm-360", kind: Wing, title: "IBM System/360 Wing", tagline: "The family that made compatible a word, and APL\\360 running on it.", summary: "A future wing for System/360 machines and software.", status: Placeholder, children: [], scene: None, links: []),
        (id: "ibm-370", kind: Wing, title: "IBM System/370 Wing", tagline: "Virtual memory, VM/370, and the machines that ran the 1970s.", summary: "A future wing for System/370 systems.", status: Placeholder, children: [], scene: None, links: []),
        (id: "ibm-390", kind: Wing, title: "IBM System/390 Wing", tagline: "ESA/390 assembler and the batch pipelines of CMS and TSO.", summary: "A future wing for System/390 systems.", status: Placeholder, children: [], scene: None, links: []),
